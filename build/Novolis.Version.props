<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Template: copy build/version.json and run scripts/sync-version-props.ps1 in each package repo.
    Do not use eng/ (ambiguous). Do not use .novolis/version.props (deprecated).
  -->
  <Import Project="$(MSBuildThisFileDirectory)version.props"
          Condition="Exists('$(MSBuildThisFileDirectory)version.props')" />
</Project>
