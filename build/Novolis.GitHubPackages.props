<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Links published .nupkg to the source repo so GPR inherits public-repo read access. -->
  <PropertyGroup Condition="'$(NovolisGitHubRepository)' != '' And '$(RepositoryUrl)' == ''">
    <RepositoryUrl>https://github.com/Novolis-Platform/$(NovolisGitHubRepository)</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Novolis-Platform/$(NovolisGitHubRepository)</PackageProjectUrl>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Novolis.PackageIcon.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Novolis.PackageIcon.props')" />
</Project>

