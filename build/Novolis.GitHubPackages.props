<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Import Project="$(MSBuildThisFileDirectory)Novolis.PackageIcon.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Novolis.PackageIcon.props')" />

  <!-- Runs after the project body sets PackageId and Description. -->
  <Target Name="NovolisPackageGalleryMetadata" BeforeTargets="GenerateNuspec" Condition="'$(IsPackable)' == 'true'">
    <PropertyGroup>
      <RepositoryUrl Condition="'$(RepositoryUrl)' == '' and '$(NovolisGitHubRepository)' != ''">https://github.com/Novolis-Platform/$(NovolisGitHubRepository)</RepositoryUrl>
      <RepositoryType Condition="'$(RepositoryType)' == ''">git</RepositoryType>
      <PackageProjectUrl Condition="'$(PackageProjectUrl)' == '' and '$(NovolisGitHubRepository)' != ''">https://novolis-platform.github.io/.github/$(NovolisGitHubRepository)/</PackageProjectUrl>
      <Authors Condition="'$(Authors)' == ''">Novolis</Authors>
      <Copyright Condition="'$(Copyright)' == ''">Copyright (c) Novolis-Platform</Copyright>
      <PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == ''">MIT</PackageLicenseExpression>
      <PackageProjectUrl Condition="'$(NovolisGitHubRepository)' != '' and ('$(PackageProjectUrl)' == '' or $(PackageProjectUrl.StartsWith('https://github.com/Novolis-Platform/')))">https://novolis-platform.github.io/.github/$(NovolisGitHubRepository)/</PackageProjectUrl>
      <PackageTags Condition="'$(PackageTags)' == '' and '$(PackageId)' != ''">novolis $([System.String]::Copy('$(PackageId)').Replace('Novolis.','').Replace('.',' ').ToLowerInvariant())</PackageTags>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Description)' == '' or '$(Description)' == 'Package Description'">
      <Description Condition="'$(NovolisPackageDescription)' != ''">$(NovolisPackageDescription)</Description>
      <Description Condition="'$(Description)' == '' or '$(Description)' == 'Package Description'">$(PackageId) for the Novolis platform.</Description>
      <PackageDescription>$(Description)</PackageDescription>
    </PropertyGroup>
  </Target>
</Project>

