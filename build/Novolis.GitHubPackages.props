<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Links published .nupkg to the source repo so GPR inherits public-repo read access. -->
  <PropertyGroup Condition="'$(NovolisGitHubRepository)' != '' And '$(RepositoryUrl)' == ''">
    <RepositoryUrl>https://github.com/Novolis-Platform/$(NovolisGitHubRepository)</RepositoryUrl>
  </PropertyGroup>
</Project>
