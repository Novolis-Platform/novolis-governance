<Project>
  <!--
    Analyzer ProjectReference when novolis-analyzers is checked out.
    Independent of ProjectReference mode: there is no PackageReference to StackBoundaries
    in csproj files, so Novolis.ProjectReferenceMode.targets does not substitute it.
    Keep OutputItemType=Analyzer here; do not dual-wire via substitution.

    Applies to Novolis.* libraries (not *.Unit / *.Tests) so NOV2006/NOV2007/NOV2008/NOV2009
    and Conventions (NOV2101/NOV2102) fire on Math → Physics → Simulation → Gaming → Avalonia
    spine + Avalonia isolation + naming conventions.
  -->
  <PropertyGroup>
    <_NovolisAnalyzersRoot>$(MSBuildThisFileDirectory)..\..\novolis-analyzers\src</_NovolisAnalyzersRoot>
    <_NovolisStackAnalyzerProject>$(_NovolisAnalyzersRoot)\Novolis.Analyzers.StackBoundaries\Novolis.Analyzers.StackBoundaries.csproj</_NovolisStackAnalyzerProject>
    <_NovolisConventionsAnalyzerProject>$(_NovolisAnalyzersRoot)\Novolis.Analyzers.Conventions\Novolis.Analyzers.Conventions.csproj</_NovolisConventionsAnalyzerProject>
    <_NovolisIsStackAnalyzedLibrary Condition="
      $(MSBuildProjectName.StartsWith('Novolis.'))
      AND !$(MSBuildProjectName.EndsWith('.Unit'))
      AND !$(MSBuildProjectName.EndsWith('.Tests'))
      AND !$(MSBuildProjectName.Contains('.Unit.'))">true</_NovolisIsStackAnalyzedLibrary>
  </PropertyGroup>
  <ItemGroup Condition="'$(NovolisStackAnalyzers)' != 'false' AND '$(_NovolisIsStackAnalyzedLibrary)' == 'true' AND Exists('$(_NovolisStackAnalyzerProject)')">
    <ProjectReference
      Include="$(_NovolisStackAnalyzerProject)"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(NovolisStackAnalyzers)' != 'false' AND '$(_NovolisIsStackAnalyzedLibrary)' == 'true' AND Exists('$(_NovolisConventionsAnalyzerProject)')">
    <ProjectReference
      Include="$(_NovolisConventionsAnalyzerProject)"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
