<Project>
  <!-- Package README: explicit pack + PackageReadmeFile. NU5118 (duplicate readme) is a known SDK/NuGet interaction when both apply; do not treat as error. -->
  <PropertyGroup>
    <PackageReadmeFile Condition="'$(PackageReadmeFile)' == ''">README.md</PackageReadmeFile>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU5118</WarningsNotAsErrors>
    <_NovolisPackageReadmePath>$(MSBuildProjectDirectory)\README.md</_NovolisPackageReadmePath>
  </PropertyGroup>
  <Target Name="_NovolisRequirePackageReadme" BeforeTargets="PrepareForBuild;Pack"
          Condition="'$(IsPackable)' == 'true' AND !Exists('$(_NovolisPackageReadmePath)')">
    <Error Text="Packable project requires README.md next to the .csproj: $(_NovolisPackageReadmePath)" />
  </Target>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('$(_NovolisPackageReadmePath)')" />
  </ItemGroup>
</Project>
