<Project>
  <!--
    The product UI contract is opt-out only for non-UI processes. Avalonia
    and MAUI application projects must carry the matching profile package so
    the shared visual baseline cannot silently disappear from a new host.
  -->
  <PropertyGroup>
    <NovolisGraphicalProfile Condition="'$(NovolisGraphicalProfile)' == ''">true</NovolisGraphicalProfile>
  </PropertyGroup>

  <Target
    Name="VerifyNovolisGraphicalProfileReference"
    BeforeTargets="ResolveReferences"
    Condition="'$(NovolisGraphicalProfile)' != 'false' and '$(IsTestProject)' != 'true' and ('$(UseMaui)' == 'true' or '$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe')">
    <PropertyGroup>
      <_NovolisGraphicalProfileRefs>@(PackageReference);@(ProjectReference)</_NovolisGraphicalProfileRefs>
    </PropertyGroup>
    <Error
      Condition="'$(UseMaui)' == 'true' and !$(_NovolisGraphicalProfileRefs.Contains('Novolis.Maui.GraphicalProfile'))"
      Text="MAUI UI projects must reference Novolis.Maui.GraphicalProfile through LibraryReference." />
    <Error
      Condition="'$(UseMaui)' != 'true' and $(_NovolisGraphicalProfileRefs.Contains('Avalonia')) and !$(_NovolisGraphicalProfileRefs.Contains('Novolis.Avalonia.GraphicalProfile'))"
      Text="Avalonia UI projects must reference Novolis.Avalonia.GraphicalProfile through LibraryReference." />
  </Target>
</Project>
