<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Expand LibraryReference after the package map is loaded and after
    ProjectReference-mode substitution. A missing sibling becomes a
    PackageReference even when NovolisUseProjectReferences=true.

    Live sources win when novolis-msbuild is checked out. CI clones governance
    only, and uses the copy under build/libraryreference/. Keep those files
    identical to the package (verify-project-ref-mode.ps1).
  -->
  <PropertyGroup>
    <LibraryReferenceDefaultVersion Condition="'$(LibraryReferenceDefaultVersion)' == '' and '$(NovolisPackageFloatVersion)' != ''">$(NovolisPackageFloatVersion)</LibraryReferenceDefaultVersion>
    <LibraryReferenceDefaultVersion Condition="'$(LibraryReferenceDefaultVersion)' == '' and '$(NovolisYear)' != '' and '$(NovolisMajor)' != ''">$(NovolisYear).$(NovolisMajor).*</LibraryReferenceDefaultVersion>
    <LibraryReferenceDefaultVersion Condition="'$(LibraryReferenceDefaultVersion)' == ''">2026.1.*</LibraryReferenceDefaultVersion>
    <_NovolisLibraryReferenceBuild>$([System.IO.Path]::Combine('$(NovolisWorkspaceRoot)', 'novolis-msbuild', 'src', 'Novolis.MSBuild.LibraryReference', 'build'))</_NovolisLibraryReferenceBuild>
    <_NovolisLibraryReferenceTargets>$([System.IO.Path]::Combine('$(_NovolisLibraryReferenceBuild)', 'Novolis.MSBuild.LibraryReference.targets'))</_NovolisLibraryReferenceTargets>
    <_NovolisLibraryReferenceBuild Condition="!Exists('$(_NovolisLibraryReferenceTargets)')">$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'libraryreference'))</_NovolisLibraryReferenceBuild>
    <_NovolisLibraryReferenceProps>$([System.IO.Path]::Combine('$(_NovolisLibraryReferenceBuild)', 'Novolis.MSBuild.LibraryReference.props'))</_NovolisLibraryReferenceProps>
    <_NovolisLibraryReferenceTargets>$([System.IO.Path]::Combine('$(_NovolisLibraryReferenceBuild)', 'Novolis.MSBuild.LibraryReference.targets'))</_NovolisLibraryReferenceTargets>
  </PropertyGroup>

  <Import Project="$(_NovolisLibraryReferenceProps)" Condition="Exists('$(_NovolisLibraryReferenceProps)')" />
  <Import Project="$(_NovolisLibraryReferenceTargets)" Condition="Exists('$(_NovolisLibraryReferenceTargets)')" />
</Project>
