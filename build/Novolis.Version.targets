<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Version intent: build/version.json (YEAR.MAJOR.MINOR). BUILD = github.run_number in CI only.
    CI passes -p:PackageVersion=YEAR.MAJOR.MINOR.BUILD which must not be overridden here.
  -->
  <PropertyGroup Condition="'$(NovolisYear)' != ''">
    <NovolisPlatformVersion Condition="'$(NovolisPlatformVersion)' == ''">$(NovolisYear).$(NovolisMajor).$(NovolisMinor)</NovolisPlatformVersion>
    <NovolisPackageFloatVersion Condition="'$(NovolisPackageFloatVersion)' == ''">$(NovolisYear).$(NovolisMajor).*</NovolisPackageFloatVersion>
  </PropertyGroup>
  <!-- Back-compat with older generated props -->
  <PropertyGroup Condition="'$(NovolisSdkYear)' != '' AND '$(NovolisYear)' == ''">
    <NovolisYear>$(NovolisSdkYear)</NovolisYear>
    <NovolisMajor>$(NovolisApiBreak)</NovolisMajor>
    <NovolisMinor>$(NovolisFeature)</NovolisMinor>
    <NovolisPlatformVersion>$(NovolisSdkYear).$(NovolisApiBreak).$(NovolisFeature)</NovolisPlatformVersion>
    <NovolisPackageFloatVersion>$(NovolisPlatformVersion).*</NovolisPackageFloatVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Local pack: YEAR.MAJOR.MINOR.{NovolisLocalBuild} when CI did not set PackageVersion -->
  <PropertyGroup Condition="'$(NovolisPlatformVersion)' != '' AND '$(PackageVersion)' == '' AND ('$(IsPackable)' == 'true' OR '$(GeneratePackageOnBuild)' == 'true')">
    <Version>$(NovolisPlatformVersion).$(NovolisLocalBuild)</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <AssemblyVersion>$(NovolisYear).$(NovolisMajor).0.0</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PackageVersion)' != '' AND '$(NovolisYear)' != '' AND '$(AssemblyVersion)' == ''">
    <AssemblyVersion>$(NovolisYear).$(NovolisMajor).0.0</AssemblyVersion>
  </PropertyGroup>
</Project>
