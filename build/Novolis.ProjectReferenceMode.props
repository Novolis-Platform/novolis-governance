<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    ProjectReference mode: when building Novolis.Platform (meta solution), substitute
    Novolis.* PackageReferences with sibling ProjectReferences via generated map.
    See docs/platform-project-ref-mode.md
  -->

  <!-- Workspace root = parent of novolis-governance (this file lives in build/). -->
  <PropertyGroup>
    <NovolisWorkspaceRoot Condition="'$(NovolisWorkspaceRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</NovolisWorkspaceRoot>
    <NovolisWorkspaceRoot Condition="'$(NovolisWorkspaceRoot)' != ''">$([System.IO.Path]::GetFullPath('$(NovolisWorkspaceRoot)'))</NovolisWorkspaceRoot>
    <!-- Labs may point this at a selected-library checkout root such as
         d:\novolis\novolis-lab\submodules. The default is the workspace forest. -->
    <NovolisLibraryRoot Condition="'$(NovolisLibraryRoot)' == ''">$(NovolisWorkspaceRoot)</NovolisLibraryRoot>
    <!-- MSBuild property functions do not expose Path.GetFullPath(path, basePath); use NormalizePath. -->
    <NovolisLibraryRoot Condition="'$(NovolisLibraryRoot)' != ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(NovolisLibraryRoot)'))</NovolisLibraryRoot>
  </PropertyGroup>

  <!-- Explicit -p / env wins; otherwise auto-enable for meta solution or a local forest checkout. -->
  <PropertyGroup>
    <_NovolisCiBuild Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true' Or '$(TF_BUILD)' == 'true' Or '$(ContinuousIntegrationBuild)' == 'true'">true</_NovolisCiBuild>
    <!-- Forest = generated map + at least one sibling library src tree (CI clones lack these). -->
    <_NovolisForestMapPresent Condition="Exists('$(MSBuildThisFileDirectory)generated\Novolis.PackageToProject.props')">true</_NovolisForestMapPresent>
    <_NovolisForestLibrariesPresent Condition="Exists('$(NovolisWorkspaceRoot)novolis-math\src') Or Exists('$(NovolisWorkspaceRoot)novolis-rendering\src') Or Exists('$(NovolisWorkspaceRoot)novolis-raylib\src')">true</_NovolisForestLibrariesPresent>
    <NovolisUseProjectReferences Condition="'$(NovolisUseProjectReferences)' == '' and '$(SolutionName)' == 'Novolis.Platform'">true</NovolisUseProjectReferences>
    <NovolisUseProjectReferences Condition="'$(NovolisUseProjectReferences)' == '' and ('$(NOVOLIS_USE_PROJECT_REFERENCES)' == 'true' or '$(NOVOLIS_USE_PROJECT_REFERENCES)' == '1')">true</NovolisUseProjectReferences>
    <NovolisUseProjectReferences Condition="'$(NovolisUseProjectReferences)' == '' and '$(_NovolisCiBuild)' != 'true' and '$(_NovolisForestMapPresent)' == 'true' and '$(_NovolisForestLibrariesPresent)' == 'true'">true</NovolisUseProjectReferences>
    <NovolisUseProjectReferences Condition="'$(NovolisUseProjectReferences)' == ''">false</NovolisUseProjectReferences>
  </PropertyGroup>

  <!--
    Forest ProjectRef restores evaluate every sibling library project. Those repos
    enable SourceLink + NuGetAudit by default; SourceLink then calls GitHub and
    under rate limits `dotnet run` sits on Restore for tens of seconds.
  -->
  <PropertyGroup Condition="'$(NovolisUseProjectReferences)' == 'true'">
    <EnableSourceLink>false</EnableSourceLink>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup Condition="'$(NovolisUseProjectReferences)' == 'true'">
    <PackageReference Remove="Microsoft.SourceLink.GitHub" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)generated\Novolis.PackageToProject.props"
          Condition="Exists('$(MSBuildThisFileDirectory)generated\Novolis.PackageToProject.props')" />

  <!-- Optional LibraryReference map (Novolis.MSBuild.LibraryReference). -->
  <Import Project="$(MSBuildThisFileDirectory)Novolis.LibraryReferenceBridge.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Novolis.LibraryReferenceBridge.props')" />

  <PropertyGroup>
    <NovolisUseMSBuildInfrastructureBridge Condition="'$(NovolisUseMSBuildInfrastructureBridge)' == '' and '$(NovolisUseProjectReferences)' == 'true'">true</NovolisUseMSBuildInfrastructureBridge>
    <NovolisUseMSBuildInfrastructureBridge Condition="'$(NovolisUseMSBuildInfrastructureBridge)' == ''">false</NovolisUseMSBuildInfrastructureBridge>
    <_NovolisMSBuildInfrastructureBridgeEnabled Condition="'$(NovolisUseMSBuildInfrastructureBridge)' == 'true'">true</_NovolisMSBuildInfrastructureBridgeEnabled>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Novolis.MSBuild.InfrastructureBridge.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Novolis.MSBuild.InfrastructureBridge.props')" />

  <Import Project="$(MSBuildThisFileDirectory)Novolis.Android.JavaSdk.props"
          Condition="'$(_NovolisAndroidJavaSdkPropsImported)' != 'true' and Exists('$(MSBuildThisFileDirectory)Novolis.Android.JavaSdk.props')" />
</Project>
