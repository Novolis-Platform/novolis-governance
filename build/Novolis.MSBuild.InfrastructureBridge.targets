<Project>
  <PropertyGroup>
    <_NovolisMSBuildRoot Condition="'$(_NovolisMSBuildRoot)' == ''">$(NovolisWorkspaceRoot)novolis-msbuild\src</_NovolisMSBuildRoot>
  </PropertyGroup>

  <Import Project="$(_NovolisMSBuildRoot)\Novolis.MSBuild.BuildReference\build\Novolis.MSBuild.BuildReference.targets"
          Condition="'$(_NovolisMSBuildInfrastructureBridgeEnabled)' == 'true'
            and Exists('$(_NovolisMSBuildRoot)\Novolis.MSBuild.BuildReference\build\Novolis.MSBuild.BuildReference.targets')" />
  <Import Project="$(_NovolisMSBuildRoot)\Novolis.MSBuild.CodeGen\build\Novolis.MSBuild.CodeGen.targets"
          Condition="'$(_NovolisMSBuildInfrastructureBridgeEnabled)' == 'true'
            and Exists('$(_NovolisMSBuildRoot)\Novolis.MSBuild.CodeGen\build\Novolis.MSBuild.CodeGen.targets')" />
  <Import Project="$(_NovolisMSBuildRoot)\Novolis.MSBuild.Packaging\build\Novolis.MSBuild.Packaging.targets"
          Condition="'$(_NovolisMSBuildInfrastructureBridgeEnabled)' == 'true'
            and Exists('$(_NovolisMSBuildRoot)\Novolis.MSBuild.Packaging\build\Novolis.MSBuild.Packaging.targets')" />
  <Import Project="$(_NovolisMSBuildRoot)\Novolis.MSBuild.ToolReference\build\Novolis.MSBuild.ToolReference.targets"
          Condition="'$(_NovolisMSBuildInfrastructureBridgeEnabled)' == 'true'
            and Exists('$(_NovolisMSBuildRoot)\Novolis.MSBuild.ToolReference\build\Novolis.MSBuild.ToolReference.targets')" />
</Project>
