{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novolis.dev/schemas/cad/novolis.cad.layers.schema.json",
  "title": "novolis.cad.layers",
  "description": "Reusable CAD layer catalog (NCS / ISO 13567 / custom). File extension: .cadlayers.json. Companion to novolis.cad — not a building model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "name", "standard", "layers"],
  "properties": {
    "format": { "const": "novolis.cad.layers" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "standard": {
      "type": "string",
      "enum": ["NCS", "ISO13567", "custom"],
      "description": "Layer naming convention this catalog follows"
    },
    "standardVersion": {
      "type": "string",
      "description": "Convention edition, e.g. \"6\" for NCS v6"
    },
    "generator": { "$ref": "#/$defs/generator" },
    "createdAt": { "type": "string", "format": "date-time" },
    "modifiedAt": { "type": "string", "format": "date-time" },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/catalogLayer" }
    },
    "properties": { "$ref": "#/$defs/propertiesBag" }
  },
  "$defs": {
    "rgb": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "propertiesBag": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" }
        ]
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "catalogLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Layer name, e.g. A-WALL-FULL (NCS)"
        },
        "discipline": {
          "type": "string",
          "description": "NCS discipline designator, e.g. A, S, G"
        },
        "major": {
          "type": "string",
          "description": "NCS major group, e.g. WALL, DOOR"
        },
        "minor": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional NCS minor group codes"
        },
        "status": {
          "type": ["string", "null"],
          "description": "Optional NCS status field"
        },
        "description": { "type": "string" },
        "defaultColor": { "$ref": "#/$defs/rgb" },
        "defaultLineWeightMm": { "type": "number", "minimum": 0 },
        "defaultLinetype": { "type": "string", "default": "Continuous" },
        "plot": { "type": "boolean", "default": true },
        "properties": { "$ref": "#/$defs/propertiesBag" }
      }
    }
  }
}
