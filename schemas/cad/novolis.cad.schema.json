{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novolis.dev/schemas/cad/novolis.cad.schema.json",
  "title": "novolis.cad",
  "description": "Authoring description of 2D sketch + 3D solid objects (parametric), layers, styles, and view state. File extension: .cadjson. Optional companions: .cadlayers.json (layer catalog), .cadshapejson (appearance/material).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "name", "unitScaleMeters", "linearUnit", "angleUnit", "coordinateSystem", "layers", "entities"],
  "properties": {
    "format": { "const": "novolis.cad" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "generator": { "$ref": "#/$defs/generator" },
    "createdAt": { "type": "string", "format": "date-time" },
    "modifiedAt": { "type": "string", "format": "date-time" },
    "unitScaleMeters": { "type": "number", "exclusiveMinimum": 0 },
    "linearUnit": { "const": "meter" },
    "angleUnit": { "const": "radian" },
    "coordinateSystem": { "$ref": "#/$defs/coordinateSystem" },
    "layersDocument": {
      "type": "string",
      "description": "Relative path to a .cadlayers.json catalog; document layers[].name should match catalog names"
    },
    "shapesDocument": {
      "type": "string",
      "description": "Relative path to a .cadshapejson shape library"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/layer" }
    },
    "linetypes": {
      "type": "array",
      "items": { "$ref": "#/$defs/linetype" }
    },
    "shapes": {
      "type": "array",
      "description": "Optional inline shapes (single-file sketches); prefer shapesDocument when sharing across docs",
      "items": { "$ref": "#/$defs/inlineShape" }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "camera": { "$ref": "#/$defs/camera" },
    "properties": { "$ref": "#/$defs/propertiesBag" }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" },
      "description": "[x, y, z]"
    },
    "quat": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" },
      "description": "[x, y, z, w]"
    },
    "rgb": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "rgba": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "propertiesBag": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" }
        ]
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handedness", "upAxis", "forwardAxis"],
      "properties": {
        "handedness": { "enum": ["right", "left"] },
        "upAxis": { "enum": ["x", "y", "z"] },
        "forwardAxis": { "enum": ["x", "y", "z"] }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "catalogId": {
          "$ref": "#/$defs/uuid",
          "description": "Optional id of the matching entry in layersDocument"
        },
        "visible": { "type": "boolean", "default": true },
        "locked": { "type": "boolean", "default": false },
        "color": { "$ref": "#/$defs/rgb" },
        "properties": { "$ref": "#/$defs/propertiesBag" }
      }
    },
    "inlineShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "description": "Inline subset of novolis.cad.shape shape entries",
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "extensions": {
          "type": "object",
          "description": "Namespaced metadata (appearance, material, …); see novolis.cad.shape",
          "additionalProperties": {
            "type": "object"
          }
        },
        "properties": { "$ref": "#/$defs/propertiesBag" }
      }
    },
    "linetype": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "pattern": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Dash pattern lengths (positive = draw, negative = gap), millimetres or drawing units"
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linetype": { "type": "string", "default": "Continuous" },
        "lineWeightMm": { "type": "number", "minimum": 0 },
        "color": { "$ref": "#/$defs/rgb" },
        "colorIndex": { "type": "integer", "minimum": 1, "maximum": 255 }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "yaw": { "type": "number" },
        "pitch": { "type": "number" },
        "distance": { "type": "number", "exclusiveMinimum": 0 },
        "target": { "$ref": "#/$defs/vec3" }
      }
    },
    "entityBase": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "layerId": { "$ref": "#/$defs/uuid" },
        "parentId": { "$ref": "#/$defs/uuid" },
        "kind": { "type": "string" },
        "hooks": {
          "type": "array",
          "description": "Optional semantic hooks for runtime identification (e.g., door, bridge access).",
          "items": { "$ref": "#/$defs/hook" }
        },
        "shapeId": {
          "$ref": "#/$defs/uuid",
          "description": "Optional shape from shapesDocument or inline shapes[]; prefer over duplicating color/material"
        },
        "style": { "$ref": "#/$defs/style" },
        "material": {
          "type": "string",
          "description": "Local override; wins over shape extensions.material when set"
        },
        "color": {
          "$ref": "#/$defs/rgb",
          "description": "Local override; wins over shape extensions.appearance when set"
        },
        "properties": { "$ref": "#/$defs/propertiesBag" }
      }
    },
    "entity": {
      "oneOf": [
        { "$ref": "#/$defs/entityGroup" },
        { "$ref": "#/$defs/entityLine" },
        { "$ref": "#/$defs/entityPolyline" },
        { "$ref": "#/$defs/entityCircle" },
        { "$ref": "#/$defs/entityArc" },
        { "$ref": "#/$defs/entityRect" },
        { "$ref": "#/$defs/entitySpline" },
        { "$ref": "#/$defs/entityBox" },
        { "$ref": "#/$defs/entitySphere" },
        { "$ref": "#/$defs/entityCylinder" },
        { "$ref": "#/$defs/entityCone" },
        { "$ref": "#/$defs/entityWedge" },
        { "$ref": "#/$defs/entityWall" },
        { "$ref": "#/$defs/entitySpace" },
        { "$ref": "#/$defs/entityInstance" },
        { "$ref": "#/$defs/entityArrayInstance" },
        { "$ref": "#/$defs/entityOpening" },
        { "$ref": "#/$defs/entityBoolean" },
        { "$ref": "#/$defs/entityWeld" }
      ]
    },
    "entityGroup": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "properties": { "kind": { "const": "group" } },
          "required": ["kind"]
        }
      ]
    },
    "entityLine": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind", "a", "b"],
          "properties": {
            "kind": { "const": "line" },
            "a": { "$ref": "#/$defs/vec3" },
            "b": { "$ref": "#/$defs/vec3" }
          }
        }
      ]
    },
    "entityPolyline": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind", "points", "closed"],
          "properties": {
            "kind": { "const": "polyline" },
            "points": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/vec3" }
            },
            "closed": { "type": "boolean" },
            "bulges": {
              "type": "array",
              "items": { "type": "number" }
            }
          }
        }
      ]
    },
    "entityCircle": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind", "center", "radius"],
          "properties": {
            "kind": { "const": "circle" },
            "center": { "$ref": "#/$defs/vec3" },
            "radius": { "type": "number", "exclusiveMinimum": 0 },
            "normal": { "$ref": "#/$defs/vec3" }
          }
        }
      ]
    },
    "entityArc": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind", "center", "radius", "startAngle", "endAngle"],
          "properties": {
            "kind": { "const": "arc" },
            "center": { "$ref": "#/$defs/vec3" },
            "radius": { "type": "number", "exclusiveMinimum": 0 },
            "startAngle": { "type": "number" },
            "endAngle": { "type": "number" },
            "normal": { "$ref": "#/$defs/vec3" }
          }
        }
      ]
    },
    "entityRect": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "rect" },
            "center": { "$ref": "#/$defs/vec3" },
            "halfExtents": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": { "type": "number", "exclusiveMinimum": 0 }
            },
            "min": { "$ref": "#/$defs/vec3" },
            "max": { "$ref": "#/$defs/vec3" },
            "a": { "$ref": "#/$defs/vec3" },
            "b": { "$ref": "#/$defs/vec3" },
            "normal": { "$ref": "#/$defs/vec3" }
          }
        }
      ]
    },
    "entitySpline": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind", "degree", "controlPoints", "knots"],
          "properties": {
            "kind": { "const": "spline" },
            "degree": { "type": "integer", "minimum": 1 },
            "controlPoints": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/vec3" }
            },
            "knots": {
              "type": "array",
              "minItems": 4,
              "items": { "type": "number" },
              "description": "Nondecreasing; length = controlPoints.length + degree + 1 for clamped open curves"
            },
            "weights": {
              "type": "array",
              "items": { "type": "number", "exclusiveMinimum": 0 }
            },
            "closed": { "type": "boolean", "default": false },
            "periodic": { "type": "boolean", "default": false },
            "fitPoints": {
              "type": "array",
              "items": { "$ref": "#/$defs/vec3" }
            },
            "normal": { "$ref": "#/$defs/vec3" }
          }
        }
      ]
    },
    "entityBox": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind", "center", "halfExtents"],
          "properties": {
            "kind": { "const": "box" },
            "center": { "$ref": "#/$defs/vec3" },
            "halfExtents": { "$ref": "#/$defs/vec3" },
            "rotationY": { "type": "number" },
            "rotation": { "$ref": "#/$defs/quat" }
          }
        }
      ]
    },
    "entitySphere": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind", "center", "radius"],
          "properties": {
            "kind": { "const": "sphere" },
            "center": { "$ref": "#/$defs/vec3" },
            "radius": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "entityCylinder": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind", "center", "radius", "height"],
          "properties": {
            "kind": { "const": "cylinder" },
            "center": { "$ref": "#/$defs/vec3" },
            "radius": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "rotationY": { "type": "number" }
          }
        }
      ]
    },
    "entityCone": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind", "center", "radius", "height"],
          "properties": {
            "kind": { "const": "cone" },
            "center": { "$ref": "#/$defs/vec3" },
            "radius": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "rotationY": { "type": "number" }
          }
        }
      ]
    },
    "entityWedge": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind", "center", "halfExtents"],
          "properties": {
            "kind": { "const": "wedge" },
            "center": { "$ref": "#/$defs/vec3" },
            "halfExtents": { "$ref": "#/$defs/vec3" },
            "rotationY": { "type": "number" }
          }
        }
      ]
    },
    "wallSide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shapeId": {
          "$ref": "#/$defs/uuid",
          "description": "Appearance/material for this face via novolis.cad.shape"
        }
      }
    },
    "wallSides": {
      "type": "object",
      "additionalProperties": false,
      "description": "Side A = left of directed baseline a→b with world up +Y (right-hand). Side B = opposite.",
      "properties": {
        "a": { "$ref": "#/$defs/wallSide" },
        "b": { "$ref": "#/$defs/wallSide" }
      }
    },
    "entityWall": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind", "thickness", "height", "deck"],
          "properties": {
            "kind": { "const": "wall" },
            "a": {
              "$ref": "#/$defs/vec3",
              "description": "Baseline start (single segment); omit if points is set"
            },
            "b": {
              "$ref": "#/$defs/vec3",
              "description": "Baseline end (single segment); omit if points is set"
            },
            "points": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/vec3" },
              "description": "Multi-segment baseline; preferred over a/b when length > 2"
            },
            "thickness": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "deck": {
              "type": "integer",
              "description": "Deck index for Calypso-style stacks (−1, 0, +1, …)"
            },
            "sides": { "$ref": "#/$defs/wallSides" }
          }
        }
      ]
    },
    "entitySpace": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind", "points", "deck", "height"],
          "properties": {
            "kind": { "const": "space" },
            "points": {
              "type": "array",
              "minItems": 3,
              "items": { "$ref": "#/$defs/vec3" },
              "description": "Closed footprint (last point need not repeat first)"
            },
            "deck": {
              "type": "integer",
              "description": "Deck index (−1, 0, +1, …)"
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Clear height of the space in meters"
            },
            "floorShapeId": { "$ref": "#/$defs/uuid" },
            "ceilingShapeId": { "$ref": "#/$defs/uuid" },
            "flags": { "$ref": "#/$defs/spaceFlags" }
          }
        }
      ]
    }
    ,
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tag", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "tag": { "type": "string", "minLength": 1, "description": "Semantic tag for lookup in the runtime." },
        "position": { "$ref": "#/$defs/vec3" },
        "normal": { "$ref": "#/$defs/vec3" },
        "properties": { "$ref": "#/$defs/propertiesBag" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center"],
      "properties": {
        "center": { "$ref": "#/$defs/vec3" },
        "rotationY": { "type": "number", "description": "Rotation around world +Y, radians." },
        "rotationQuat": {
          "type": "array",
          "description": "Quaternion rotation (x,y,z,w).",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "scale": { "$ref": "#/$defs/vec3", "description": "Per-axis scale; default is (1,1,1) when omitted by producer." }
      }
    },
    "spaceFlags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enclosed": { "type": "boolean", "description": "True when the space cannot be reached from outside via openings." },
        "hollow": { "type": "boolean", "description": "True when the space contains a vertical void/open-top connection." }
      }
    },
    "entityInstance": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind", "prototypeId", "transform"],
          "properties": {
            "kind": { "const": "instance" },
            "prototypeId": { "$ref": "#/$defs/uuid" },
            "transform": { "$ref": "#/$defs/transform" }
          }
        }
      ]
    },
    "entityArrayInstance": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind", "prototypeId", "baseTransform", "counts", "spacing"],
          "properties": {
            "kind": { "const": "arrayInstance" },
            "prototypeId": { "$ref": "#/$defs/uuid" },
            "baseTransform": { "$ref": "#/$defs/transform" },
            "counts": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "type": "integer", "minimum": 1 },
              "description": "Counts in X,Y,Z directions."
            },
            "spacing": { "$ref": "#/$defs/vec3", "description": "Spacing between adjacent instances (meters)." }
          }
        }
      ]
    },
    "entityOpening": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind", "openingType", "deck", "height", "footprint"],
          "properties": {
            "kind": { "const": "opening" },
            "openingType": { "type": "string", "enum": ["door", "hatch", "window", "ramp"] },
            "deck": { "type": "integer", "description": "Deck the host wall lives on." },
            "height": { "type": "number", "exclusiveMinimum": 0, "description": "Opening clear height (meters)." },
            "footprint": {
              "type": "array",
              "minItems": 3,
              "items": { "$ref": "#/$defs/vec3" },
              "description": "Polygon footprint of the opening (producer decides plane/orientation via points/normal)."
            },
            "hostWallId": { "$ref": "#/$defs/uuid", "description": "Optional host wall to cut (if producer is wall-aware)." },
            "connectsSides": {
              "type": "array",
              "items": { "type": "string", "enum": ["A", "B"] },
              "description": "Which wall sides this opening connects."
            },
            "swing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "startAngle": { "type": "number", "description": "Swing start angle (radians)." },
                "endAngle": { "type": "number", "description": "Swing end angle (radians)." },
                "direction": { "$ref": "#/$defs/vec3", "description": "Swing direction normal/axis (producer-defined)." }
              },
              "required": ["startAngle", "endAngle", "direction"]
            }
          }
        }
      ]
    },
    "entityBoolean": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind", "operation", "leftId", "rightId", "mode"],
          "properties": {
            "kind": { "const": "boolean" },
            "operation": { "type": "string", "enum": ["union", "subtract", "intersect"] },
            "leftId": { "$ref": "#/$defs/uuid", "description": "Left operand entity id." },
            "rightId": { "$ref": "#/$defs/uuid", "description": "Right operand entity id." },
            "mode": { "type": "string", "enum": ["region", "solid"], "description": "Region/2D vs Solid/3D behavior." },
            "touchEpsilonMeters": { "type": "number", "minimum": 0, "description": "Optional tolerance for coincident boundaries." }
          }
        }
      ]
    },
    "entityWeld": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["kind", "memberIds", "touchEpsilonMeters"],
          "properties": {
            "kind": { "const": "weld" },
            "memberIds": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/uuid" },
              "description": "Operand entity ids to weld/union when they touch/intersect within tolerance."
            },
            "touchEpsilonMeters": { "type": "number", "minimum": 0 }
          }
        }
      ]
    }
  }
}
