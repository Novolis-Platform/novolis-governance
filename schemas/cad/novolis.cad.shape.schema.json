{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novolis.dev/schemas/cad/novolis.cad.shape.schema.json",
  "title": "novolis.cad.shape",
  "description": "Shared shape appearance and material metadata for novolis.cad entities. File extension: .cadshapejson. No geometry — only how instances look. May reference a base .cadjson via baseDocument.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "name", "shapes"],
  "properties": {
    "format": { "const": "novolis.cad.shape" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "generator": { "$ref": "#/$defs/generator" },
    "createdAt": { "type": "string", "format": "date-time" },
    "modifiedAt": { "type": "string", "format": "date-time" },
    "baseDocument": {
      "type": "string",
      "description": "Relative path to a .cadjson when this file is a sidecar"
    },
    "shapes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/shape" }
    },
    "properties": { "$ref": "#/$defs/propertiesBag" }
  },
  "$defs": {
    "rgb": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "propertiesBag": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" }
        ]
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "color": { "$ref": "#/$defs/rgb" }
      }
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "$ref": "#/$defs/rgb" },
        "lineWeightMm": { "type": "number", "minimum": 0 },
        "linetype": { "type": "string", "default": "Continuous" }
      }
    },
    "appearanceExtension": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": { "$ref": "#/$defs/fill" },
        "stroke": { "$ref": "#/$defs/stroke" },
        "colorIndex": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255,
          "description": "Optional ACI 1–255 for DXF round-trip"
        }
      }
    },
    "materialExtension": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string",
          "description": "Named material preset (app-resolved)"
        },
        "albedo": { "$ref": "#/$defs/rgb" },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "metalness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced metadata. Known: appearance, material. Unknown namespaces allowed for forward compatibility.",
      "properties": {
        "appearance": { "$ref": "#/$defs/appearanceExtension" },
        "material": { "$ref": "#/$defs/materialExtension" }
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "extensions": { "$ref": "#/$defs/extensions" },
        "properties": { "$ref": "#/$defs/propertiesBag" }
      }
    }
  }
}
